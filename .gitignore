# ==========================================================================
# AdaptiveSense .gitignore
# ==========================================================================

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# --- macOS -----------------------------------------------------------------
.DS_Store

# --- Secrets / credentials: NEVER commit real ones --------------------------
# Firmware local configuration holds Wi-Fi passwords and MQTT credentials.
# Only config.example.h is tracked (safe placeholders).
firmware/main/config.h
firmware/sdkconfig
firmware/build/
firmware/managed_components/
firmware/.build/
firmware/dependencies.lock

# Generic secret files
*.pem
*.key
*.secret
.env
credentials*

# --- ESP-IDF --------------------------------------------------------------
firmware/partition_table/*.bin
# Any stray build tree (e.g. one moved aside while debugging a configure error)
firmware/build*/
firmware/sdkconfig.old

# --- Host-side test artifacts ---------------------------------------------
# The parity and BME280 tests compile the firmware sources for the host.
# They always build into a temporary directory, so nothing should appear here;
# these entries exist so a stray manual build can never be committed.
tests/c_host/*.o
tests/c_host/*.bin
*.parity

# --- Live / transient results ------------------------------------------------
# Committed results are the reproducible simulation outputs under results/.
# Live captures from a running node are transient and should not be tracked.
results/live/

# --- Editors ----------------------------------------------------------------
*.swp
*.swo
.idea/
.vscode/
# --- Agent / workspace metadata ---------------------------------------------
# Local assistant working notes (memory, project skills). Not project content:
# the reader-facing record lives in docs/ and results/.
.workbuddy/
